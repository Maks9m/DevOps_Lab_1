# {{ ansible_managed }}
# Reverse proxy for mywebapp — KPI DevOps Lab 4.
# Public-facing on :80; only documented routes are forwarded to the app.

server {
    listen 80 default_server;
    server_name _;

    access_log /var/log/nginx/mywebapp.access.log;
    error_log  /var/log/nginx/mywebapp.error.log;

    location = / {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /tasks {
        limit_except GET POST { deny all; }
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/tasks/[0-9]+/done$ {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health endpoints stay internal-only.
    location ^~ /health/ {
        return 404;
    }

    location / {
        return 404;
    }
}
