# {{ ansible_managed }}
[Unit]
Description=mywebapp (Task Tracker) — KPI DevOps Lab 4
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_home }}
EnvironmentFile={{ app_env_file }}
ExecStartPre=/usr/bin/python3 {{ app_home }}/migrate.py
ExecStart=/usr/bin/python3 {{ app_home }}/main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
